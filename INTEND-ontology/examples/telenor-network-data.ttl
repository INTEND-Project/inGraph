@prefix intend:  <https://w3id.org/intend/ontology#> .
@prefix telenor: <https://w3id.org/intend/extensions/telenor#> .
@prefix data:    <https://w3id.org/intend/examples/telenor-data#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#
#  Telenor Nordic edge-network data — migrated verbatim from a real
#  Telenor knowledge graph (JSON-LD export,
#  https://intendproject.eu/telenor/*, supplied 2026-08-25):
#  40 edge clusters (Denmark/Finland/Sweden/Norway), fully meshed by
#  780 measured point-to-point network links (a complete graph,
#  C(40,2) — verified programmatically against the source, no
#  missing or extra pairs). Unrelated to examples/fill-*.ttl: no
#  shared individuals, per the user's own description of the three
#  source KGs as "completamente scollegati" (completely disconnected).
#
#  KNOWN SOURCE ANOMALIES (present in the original JSON-LD, kept
#  visible here rather than silently patched):
#   - 40 links have no measured bandwidth in the source ("nan
#     Tbit/s"): telenor:bandwidthTbps is simply omitted for those,
#     not fabricated as e.g. 0. 39 of the 40 involve data:EC_40
#     (Longyearbyen/Svalbard — the only cluster on diesel generators,
#     genuinely the most remote/isolated site in the dataset), plus
#     one unrelated case, data:EC_31-EC_39 (Tromsø-Kirkenes).
#   - 34 links similarly have no measured packet error rate ("nan
#     packets/s"); telenor:packetErrorRatePerSecond is omitted for
#     those. This is NOT the same 34/40 as the missing-bandwidth
#     set — verified programmatically: 7 links are missing only
#     bandwidth (data:EC_31-EC_39, EC_34-EC_40, EC_35-EC_40,
#     EC_36-EC_40, EC_37-EC_40, EC_38-EC_40, EC_39-EC_40) and 1 link
#     is missing only packet error rate (data:EC_20-EC_39) — the two
#     gaps are independent, not a single "EC_40 is unmeasured" story.
#   - The source's bandwidth values are inconsistently formatted as
#     integers ("10 Tbit/s") or floats ("5.0 Tbit/s") for what is
#     presumably the same kind of value; both parse to the same
#     xsd:decimal here, so the distinction is not preserved.
#   - aeros:hasClass ("Infrastracture Element", sic) is a constant
#     across all 40 clusters — migrated verbatim as
#     telenor:infrastructureClass despite carrying no discriminating
#     information, for fidelity to the source.
#
#################################################################

<https://w3id.org/intend/examples/telenor-data> a owl:Ontology ;
    rdfs:label "INTEND Ontology - Telenor Nordic network data (from real KG)"@en ;
    owl:imports <https://w3id.org/intend/extensions/telenor> .

#################################################################
# Resource-layer aggregate (mirrors data:FillContinuum in
# examples/fill-instance-data.ttl — see
# shapes/intend-shapes-telenor-extension.ttl for the qualified
# cardinality check bound to this individual)
#################################################################

data:TelenorNordicContinuum a intend:Resource ;
    rdfs:label "Telenor Nordic Edge Continuum"@en ;
    intend:consistsIn data:EC_1, data:EC_2, data:EC_3, data:EC_4, data:EC_5, data:EC_6, data:EC_7, data:EC_8, data:EC_9, data:EC_10, data:EC_11, data:EC_12, data:EC_13, data:EC_14, data:EC_15, data:EC_16, data:EC_17, data:EC_18, data:EC_19, data:EC_20, data:EC_21, data:EC_22, data:EC_23, data:EC_24, data:EC_25, data:EC_26, data:EC_27, data:EC_28, data:EC_29, data:EC_30, data:EC_31, data:EC_32, data:EC_33, data:EC_34, data:EC_35, data:EC_36, data:EC_37, data:EC_38, data:EC_39, data:EC_40 .

#################################################################
# Edge clusters
#################################################################

data:EC_1 a telenor:EdgeCluster ;
    rdfs:label "Copenhagen Edge Cluster"@en ;
    telenor:clusterCode "EC_1"^^xsd:string ;
    telenor:externalId "ID_Nordic_EC_1"^^xsd:string ;
    telenor:location "Copenhagen"^^xsd:string ;
    telenor:latitude "55.6761"^^xsd:decimal ;
    telenor:longitude "12.5683"^^xsd:decimal ;
    telenor:gpuSpec "64 DGX H100 GPUs each with 8x80 GB of GPU memory"^^xsd:string ;
