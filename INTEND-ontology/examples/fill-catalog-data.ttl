    intend:name "Container1"^^xsd:string
    ; fill:compatibleWithMachineType cat:Machine1, cat:Machine2, cat:Machine3, cat:Machine4, cat:Machine5 .

cat:Container2 a fill:Container ;
    intend:name "Container2"^^xsd:string
