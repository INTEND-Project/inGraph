data:zones-passing-alert a gate:Microservice ;
    rdfs:label "Zones Passing Alert"@en ;
    intend:name "zones-passing-alert"^^xsd:string ;
    intend:description "A microservice generating alerts for zone passing events. Monitors zone transitions and triggers alerts for specific crossing patterns. Reads from zones-passing Kafka stream and produces zone passing alert events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "traffic-jam"^^xsd:string ;
    gate:keyword "detection"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "zones_passing_alert"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:zones-passing ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.zones_passing_alert> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.zones_passing> ;
    gate:hasRequiredParameter data:zones-passing-alert--KAFKA_SOURCE_BOOTSTRAP_SERVER, data:zones-passing-alert--KAFKA_DEST_BOOTSTRAP_SERVER, data:zones-passing-alert--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:zones-passing-alert--FROM_ZONE, data:zones-passing-alert--TO_ZONE, data:zones-passing-alert--OBJECT_TYPE_FILTER, data:zones-passing-alert--ALERT_SEVERITY, data:zones-passing-alert--MAX_SOURCE_EMPTY_POLLS, data:zones-passing-alert--SOURCE_AUTO_OFFSET_RESET, data:zones-passing-alert--KAFKA_SOURCE_TOPIC, data:zones-passing-alert--KAFKA_SOURCE_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:zones-passing-alert--KAFKA_CONSUMER_GROUP_ID, data:zones-passing-alert--KAFKA_DEST_TOPIC, data:zones-passing-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

