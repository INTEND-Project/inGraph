#################################################################
# Microservices
#################################################################

data:crosswalk-safety-alert a gate:Microservice ;
    rdfs:label "Crosswalk Safety Alert"@en ;
    intend:name "crosswalk-safety-alert"^^xsd:string ;
    intend:description "A microservice processing OSEF Zones data from LiDAR sensors. The processed data includes zone information such as zones definitions and bindings. The service reads a KAFKA stream of OSEF data from LiDAR sensors and produces a KAFKA stream of OSEF Zones data."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "osef-streamer"^^xsd:string ;
    gate:keyword "test"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "crosswalk_safety_alert"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:object-in-zone-detection, data:object-speeds ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.crosswalk_safety_alert> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_speeds>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_in_zone_detection> ;
    gate:hasRequiredParameter data:crosswalk-safety-alert--CROSSWALK_ZONE, data:crosswalk-safety-alert--APPROACH_ZONES, data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER, data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_BOOTSTRAP_SERVER, data:crosswalk-safety-alert--KAFKA_DEST_BOOTSTRAP_SERVER, data:crosswalk-safety-alert--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:crosswalk-safety-alert--VEHICLE_SPEED_THRESHOLD, data:crosswalk-safety-alert--MAKE_MOCK, data:crosswalk-safety-alert--MAX_SOURCE_EMPTY_POLLS, data:crosswalk-safety-alert--SOURCE_AUTO_OFFSET_RESET, data:crosswalk-safety-alert--BUCKET_TIME_WINDOW_MS, data:crosswalk-safety-alert--BUCKET_MAX_AGE_SECONDS, data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC, data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT, data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_TOPIC, data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:crosswalk-safety-alert--KAFKA_CONSUMER_GROUP_ID, data:crosswalk-safety-alert--KAFKA_DEST_TOPIC, data:crosswalk-safety-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

data:crosswalk-safety-alert--CROSSWALK_ZONE a gate:Parameter ;
    rdfs:label "CROSSWALK_ZONE"@en ;
    gate:parameterName "CROSSWALK_ZONE"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "ID or name of the target crosswalk zone. Can be numeric (e.g., '5') or a string (e.g., 'C5_main'). If numeric, it will be compared to the zone_id field of the detection message. If string, it will be compared to the zone_name field. This logic is handled automatically in the engine."^^xsd:string .

data:crosswalk-safety-alert--APPROACH_ZONES a gate:Parameter ;
    rdfs:label "APPROACH_ZONES"@en ;
    gate:parameterName "APPROACH_ZONES"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Comma-separated list of zone names or zone ids before the crosswalk (approach zones). Example: 'C5_before_1,C5_before_2', or '1,2'. Each entry can be a zone name (string) or a zone id (numeric as string). If numeric, it will be compared to the zone_id field of the detection message. If string, it will be compared to the zone_name field. This logic is handled automatically in the engine."^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Source Kafka bootstrap server for object speeds topic in the format `host:port`. This is the server from which the service will consume speed messages."^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Source Kafka bootstrap server for object-in-zone detection topic in the format `host:port`. This is the server from which the service will consume detection messages."^^xsd:string .

data:crosswalk-safety-alert--KAFKA_DEST_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_DEST_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_DEST_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Destination Kafka bootstrap server in the format `host:port`. This is the server to which the service will produce messages."^^xsd:string
    ; gate:description "Kafka bootstrap server in the format `host:port`."^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SCHEMA_REGISTRY_URL a gate:Parameter ;
    rdfs:label "KAFKA_SCHEMA_REGISTRY_URL"@en ;
    gate:parameterName "KAFKA_SCHEMA_REGISTRY_URL"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "URL of the Schema Registry for Kafka."^^xsd:string .

data:crosswalk-safety-alert--VEHICLE_SPEED_THRESHOLD a gate:Parameter ;
    rdfs:label "VEHICLE_SPEED_THRESHOLD"@en ;
    gate:parameterName "VEHICLE_SPEED_THRESHOLD"^^xsd:string ;
    gate:dataType "float"^^xsd:string
    ; gate:description "Maximum speed (m/s) allowed for vehicles in approach zones. Default: 5.0 m/s (~18 km/h). Vehicles exceeding this speed will raise a PEDESTRIAN_VEHICLE_APPROACH alert."^^xsd:string
    ; gate:defaultValue "5.0"^^xsd:string .

data:crosswalk-safety-alert--MAKE_MOCK a gate:Parameter ;
    rdfs:label "MAKE_MOCK"@en ;
    gate:parameterName "MAKE_MOCK"^^xsd:string ;
    gate:dataType "bool"^^xsd:string
    ; gate:description "If True, use mock OSEF data from tests/test_data/osef_stream_data.bin instead of the source TCP stream. When mock data ends, restart from beginning. Default: False (use real TCP stream)."^^xsd:string
    ; gate:description "If True, publishes random mock crosswalk safety alert messages every 1-2 seconds instead of executing the real logic. Messages are still consumed from topics. Default: False (use real logic)."^^xsd:string
    ; gate:defaultValue "False"^^xsd:string .

data:crosswalk-safety-alert--MAX_SOURCE_EMPTY_POLLS a gate:Parameter ;
    rdfs:label "MAX_SOURCE_EMPTY_POLLS"@en ;
    gate:parameterName "MAX_SOURCE_EMPTY_POLLS"^^xsd:string ;
    gate:dataType "Union[int, NoneType]"^^xsd:string
    ; gate:description "Maximum number of empty polls before timing out."^^xsd:string .

data:crosswalk-safety-alert--SOURCE_AUTO_OFFSET_RESET a gate:Parameter ;
    rdfs:label "SOURCE_AUTO_OFFSET_RESET"@en ;
    gate:parameterName "SOURCE_AUTO_OFFSET_RESET"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Where to start consuming messages if no committed offsets are found. Options are 'earliest' or 'latest'."^^xsd:string
    ; gate:defaultValue "latest"^^xsd:string .

data:crosswalk-safety-alert--BUCKET_TIME_WINDOW_MS a gate:Parameter ;
    rdfs:label "BUCKET_TIME_WINDOW_MS"@en ;
    gate:parameterName "BUCKET_TIME_WINDOW_MS"^^xsd:string ;
    gate:dataType "int"^^xsd:string
    ; gate:description "Time window in milliseconds for bucket matching. Messages within this window are grouped together for synchronization. Default: 1000ms (1 second)."^^xsd:string
    ; gate:defaultValue "1000"^^xsd:string .

data:crosswalk-safety-alert--BUCKET_MAX_AGE_SECONDS a gate:Parameter ;
    rdfs:label "BUCKET_MAX_AGE_SECONDS"@en ;
    gate:parameterName "BUCKET_MAX_AGE_SECONDS"^^xsd:string ;
    gate:dataType "int"^^xsd:string
    ; gate:description "Maximum age in seconds to keep time buckets before dropping them. Older buckets are discarded to prevent memory buildup. Default: 600 seconds (10 minutes)."^^xsd:string
    ; gate:defaultValue "600"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Kafka topic for object speed data."^^xsd:string
    ; gate:defaultValue "city_lab.paradise_mall_sofia.lidar.object_speeds"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the schema value subject to use for the object speeds topic."^^xsd:string
    ; gate:defaultValue "lidar.object_speeds_value"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_TOPIC a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_TOPIC"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_TOPIC"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Kafka topic for object-in-zone detection data."^^xsd:string
    ; gate:defaultValue "city_lab.paradise_mall_sofia.lidar.object_in_zone_detections"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_SCHEMA_VALUE_SUBJECT a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_SCHEMA_VALUE_SUBJECT"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_SCHEMA_VALUE_SUBJECT"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the schema value subject to use for the object-in-zone detection topic."^^xsd:string
    ; gate:defaultValue "lidar.object_in_zone_detection_value"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_CONSUMER_GROUP_ID a gate:Parameter ;
    rdfs:label "KAFKA_CONSUMER_GROUP_ID"@en ;
    gate:parameterName "KAFKA_CONSUMER_GROUP_ID"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Consumer group ID for the Kafka consumer."^^xsd:string
    ; gate:defaultValue "lidar.crosswalk_safety_alert"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_DEST_TOPIC a gate:Parameter ;
    rdfs:label "KAFKA_DEST_TOPIC"@en ;
    gate:parameterName "KAFKA_DEST_TOPIC"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the Kafka topic to produce messages to."^^xsd:string
    ; gate:defaultValue "city_lab.paradise_mall_sofia.lidar.crosswalk_safety_alert"^^xsd:string .

data:crosswalk-safety-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT a gate:Parameter ;
    rdfs:label "KAFKA_DEST_SCHEMA_VALUE_SUBJECT"@en ;
    gate:parameterName "KAFKA_DEST_SCHEMA_VALUE_SUBJECT"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the schema value subject to use for the destination topic. This should match the schema file name in the schemas directory."^^xsd:string
    ; gate:defaultValue "lidar.crosswalk_safety_alert_value"^^xsd:string .

data:flow-alert a gate:Microservice ;
    rdfs:label "Flow Alert"@en ;
    intend:name "flow-alert"^^xsd:string ;
    intend:description "A microservice detecting flow anomalies based on object counts in zones. Monitors object counting data and triggers alerts when counts exceed thresholds. Reads from object-counting Kafka stream and produces flow alert events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "traffic-jam"^^xsd:string ;
    gate:keyword "detection"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "flow_alert"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:object-counting ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.flow_alert> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_counting> ;
    gate:hasRequiredParameter data:flow-alert--KAFKA_SOURCE_OBJECT_COUNTING_BOOTSTRAP_SERVER, data:flow-alert--KAFKA_DEST_BOOTSTRAP_SERVER, data:flow-alert--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:flow-alert--ZONES_OF_INTEREST, data:flow-alert--OBJECT_TYPE_FILTER, data:flow-alert--MAX_SOURCE_EMPTY_POLLS, data:flow-alert--SOURCE_AUTO_OFFSET_RESET, data:flow-alert--KAFKA_SOURCE_OBJECT_COUNTING_TOPIC, data:flow-alert--KAFKA_SOURCE_OBJECT_COUNTING_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:flow-alert--KAFKA_CONSUMER_GROUP_ID, data:flow-alert--KAFKA_DEST_TOPIC, data:flow-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

data:flow-alert--KAFKA_SOURCE_OBJECT_COUNTING_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_OBJECT_COUNTING_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_SOURCE_OBJECT_COUNTING_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Source Kafka bootstrap server for object counting topic in the format `host:port`. This is the server from which the service will consume counting messages."^^xsd:string .

data:flow-alert--KAFKA_DEST_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_DEST_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_DEST_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Destination Kafka bootstrap server in the format `host:port`. This is the server to which the service will produce messages."^^xsd:string
    ; gate:description "Kafka bootstrap server in the format `host:port`."^^xsd:string .

data:flow-alert--KAFKA_SCHEMA_REGISTRY_URL a gate:Parameter ;
    rdfs:label "KAFKA_SCHEMA_REGISTRY_URL"@en ;
    gate:parameterName "KAFKA_SCHEMA_REGISTRY_URL"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "URL of the Schema Registry for Kafka."^^xsd:string .

data:flow-alert--ZONES_OF_INTEREST a gate:Parameter ;
    rdfs:label "ZONES_OF_INTEREST"@en ;
    gate:parameterName "ZONES_OF_INTEREST"^^xsd:string ;
    gate:dataType "list"^^xsd:string
    ; gate:description "List of zone IDs or zone names to monitor. Numeric entries are treated as IDs; non-numeric entries as names. If empty, all zones will be monitored."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) for which to generate mock detections. Numeric entries are treated as IDs; non-numeric entries as names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) to keep. Numeric entries are treated as zone IDs; non-numeric entries are treated as zone names. If empty, all zones are processed."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) for which to generate mock alerts. Numeric entries are treated as zone IDs; non-numeric entries as zone names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:description "List of zone names to keep. If empty, all zones are processed."^^xsd:string
    ; gate:description "List of zone names or zone IDs (as strings) for which to generate mock alerts. Numeric entries are treated as IDs; non-numeric entries as names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:defaultValue "[]"^^xsd:string .

