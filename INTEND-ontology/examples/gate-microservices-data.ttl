    ; gate:description "Name of the schema value subject to use for the destination topic. This should match the schema file name in the schemas directory."^^xsd:string
    ; gate:defaultValue "lidar.osef.zones_value"^^xsd:string .

data:overspeed-alert a gate:Microservice ;
    rdfs:label "Overspeed Alert"@en ;
    intend:name "overspeed-alert"^^xsd:string ;
    intend:description "A microservice detecting vehicles exceeding speed limits. Monitors vehicle speeds and generates alerts when speed thresholds are exceeded. Reads from object-speeds Kafka stream and produces overspeed alert events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "overspeed"^^xsd:string ;
    gate:keyword "alert"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "overspeed_alert"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:object-speeds, data:osef-zones ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.overspeed_alert> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_speeds>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.osef.zones> ;
    gate:hasRequiredParameter data:overspeed-alert--KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER, data:overspeed-alert--KAFKA_SOURCE_OSEF_ZONES_BOOTSTRAP_SERVER, data:overspeed-alert--KAFKA_DEST_BOOTSTRAP_SERVER, data:overspeed-alert--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:overspeed-alert--ZONES_OF_INTEREST, data:overspeed-alert--SPEED_LIMIT, data:overspeed-alert--MAX_SOURCE_EMPTY_POLLS, data:overspeed-alert--SOURCE_AUTO_OFFSET_RESET, data:overspeed-alert--BUCKET_TIME_WINDOW_MS, data:overspeed-alert--BUCKET_MAX_AGE_SECONDS, data:overspeed-alert--KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC, data:overspeed-alert--KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:overspeed-alert--KAFKA_CONSUMER_GROUP_ID, data:overspeed-alert--KAFKA_SOURCE_OSEF_ZONES_TOPIC, data:overspeed-alert--KAFKA_SOURCE_OSEF_ZONES_SCHEMA_VALUE_SUBJECT, data:overspeed-alert--KAFKA_DEST_TOPIC, data:overspeed-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

