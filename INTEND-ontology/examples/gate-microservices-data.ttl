data:osef-augmented-cloud a gate:Microservice ;
    rdfs:label "Osef Augmented Cloud"@en ;
    intend:name "osef-augmented-cloud"^^xsd:string ;
    intend:description "A microservice processing OSEF augmented cloud data comprising information about the point cloud which captures the environment and objects in the scene. The service reads a KAFKA stream of OSEF data from LiDAR sensors and produces a KAFKA stream of augmented OSEF data."^^xsd:string ;
