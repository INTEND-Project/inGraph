data:object-in-zone-detection a gate:Microservice ;
    rdfs:label "Object In Zone Detection"@en ;
    intend:name "object-in-zone-detection"^^xsd:string ;
    intend:description "A microservice processing OSEF Zones data from LiDAR sensors. The processed data includes zone information such as zones definitions and bindings. The service reads a KAFKA stream of OSEF data from LiDAR sensors and produces a KAFKA stream of OSEF Zones data."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "osef-streamer"^^xsd:string ;
    gate:keyword "test"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:chartRepository "oci://registry.gate-ai.eu/intend-charts"^^xsd:anyURI ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "object_in_zone_detection"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:osef-tracked-objects, data:osef-zones ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_in_zone_detection> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.osef.zones>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.osef.tracked_objects> ;
    gate:hasRequiredParameter data:object-in-zone-detection--KAFKA_SOURCE_ZONES_BOOTSTRAP_SERVER, data:object-in-zone-detection--KAFKA_SOURCE_OBJECTS_BOOTSTRAP_SERVER, data:object-in-zone-detection--KAFKA_DEST_BOOTSTRAP_SERVER, data:object-in-zone-detection--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:object-in-zone-detection--OBJECT_TYPE_FILTER, data:object-in-zone-detection--ZONES_OF_INTEREST, data:object-in-zone-detection--MAX_SOURCE_EMPTY_POLLS, data:object-in-zone-detection--SOURCE_AUTO_OFFSET_RESET, data:object-in-zone-detection--STRIDE, data:object-in-zone-detection--BUCKET_TIME_WINDOW_MS, data:object-in-zone-detection--BUCKET_MAX_AGE_SECONDS ;
    gate:hasFrozenParameter data:object-in-zone-detection--KAFKA_CONSUMER_GROUP_ID, data:object-in-zone-detection--KAFKA_SOURCE_ZONES_TOPIC, data:object-in-zone-detection--KAFKA_SOURCE_ZONES_SCHEMA_VALUE_SUBJECT, data:object-in-zone-detection--KAFKA_SOURCE_OBJECTS_TOPIC, data:object-in-zone-detection--KAFKA_SOURCE_OBJECTS_SCHEMA_VALUE_SUBJECT, data:object-in-zone-detection--KAFKA_DEST_TOPIC, data:object-in-zone-detection--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

data:object-in-zone-detection--KAFKA_SOURCE_ZONES_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_ZONES_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_SOURCE_ZONES_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Source Kafka bootstrap server for zones topic in the format `host:port`. This is the server from which the service will consume messages."^^xsd:string .

