    rdfs:label "KAFKA_DEST_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_DEST_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Destination Kafka bootstrap server in the format `host:port`. This is the server to which the service will produce messages."^^xsd:string
    ; gate:description "Kafka bootstrap server in the format `host:port`."^^xsd:string .

