data:lidar-osef-data-streamer a gate:Microservice ;
    rdfs:label "Lidar Osef Data Streamer"@en ;
    intend:name "lidar-osef-data-streamer"^^xsd:string ;
    intend:description "A microservice for streaming OSEF data from LiDAR sensors. The service reads OSEF blobs from a source, processes them with a specified stride, and streams the processed data to Kafka."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "osef-streamer"^^xsd:string ;
    gate:keyword "test"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:chartRepository "oci://registry.gate-ai.eu/intend-charts"^^xsd:anyURI ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "lidar_osef_data_streamer"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.osef.data_streamer> ;
    gate:hasRequiredParameter data:lidar-osef-data-streamer--OSEF_SOURCE, data:lidar-osef-data-streamer--KAFKA_DEST_BOOTSTRAP_SERVER, data:lidar-osef-data-streamer--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:lidar-osef-data-streamer--MAKE_MOCK, data:lidar-osef-data-streamer--STRIDE ;
    gate:hasFrozenParameter data:lidar-osef-data-streamer--KAFKA_DEST_TOPIC, data:lidar-osef-data-streamer--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

data:lidar-osef-data-streamer--OSEF_SOURCE a gate:Parameter ;
    rdfs:label "OSEF_SOURCE"@en ;
    gate:parameterName "OSEF_SOURCE"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Path to osef file or TCP stream. For TCP streams, use the format `tcp://hostname:port`."^^xsd:string .

data:lidar-osef-data-streamer--KAFKA_DEST_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_DEST_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_DEST_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Destination Kafka bootstrap server in the format `host:port`. This is the server to which the service will produce messages."^^xsd:string
    ; gate:description "Kafka bootstrap server in the format `host:port`."^^xsd:string .

data:lidar-osef-data-streamer--KAFKA_SCHEMA_REGISTRY_URL a gate:Parameter ;
    rdfs:label "KAFKA_SCHEMA_REGISTRY_URL"@en ;
    gate:parameterName "KAFKA_SCHEMA_REGISTRY_URL"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "URL of the Schema Registry for Kafka."^^xsd:string .

data:lidar-osef-data-streamer--MAKE_MOCK a gate:Parameter ;
    rdfs:label "MAKE_MOCK"@en ;
    gate:parameterName "MAKE_MOCK"^^xsd:string ;
    gate:dataType "bool"^^xsd:string
    ; gate:description "If True, use mock OSEF data from tests/test_data/osef_stream_data.bin instead of the source TCP stream. When mock data ends, restart from beginning. Default: False (use real TCP stream)."^^xsd:string
    ; gate:description "If True, publishes random mock crosswalk safety alert messages every 1-2 seconds instead of executing the real logic. Messages are still consumed from topics. Default: False (use real logic)."^^xsd:string
    ; gate:defaultValue "False"^^xsd:string .

data:lidar-osef-data-streamer--STRIDE a gate:Parameter ;
    rdfs:label "STRIDE"@en ;
    gate:parameterName "STRIDE"^^xsd:string ;
    gate:dataType "int"^^xsd:string
    ; gate:description "Stride for processing the KAFKA stream of OSEF data. Set to 1 to process every message. Stride of 2 will process every second message."^^xsd:string
    ; gate:description "Stride for processing the OSEF stream. Set to 1 to process every blob. Stride of 2 will process every second blob."^^xsd:string
    ; gate:defaultValue "1"^^xsd:string .

data:lidar-osef-data-streamer--KAFKA_DEST_TOPIC a gate:Parameter ;
    rdfs:label "KAFKA_DEST_TOPIC"@en ;
    gate:parameterName "KAFKA_DEST_TOPIC"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the Kafka topic to produce messages to."^^xsd:string
    ; gate:defaultValue "city_lab.paradise_mall_sofia.lidar.osef.scan_frame_dict"^^xsd:string .

data:lidar-osef-data-streamer--KAFKA_DEST_SCHEMA_VALUE_SUBJECT a gate:Parameter ;
    rdfs:label "KAFKA_DEST_SCHEMA_VALUE_SUBJECT"@en ;
    gate:parameterName "KAFKA_DEST_SCHEMA_VALUE_SUBJECT"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the schema value subject to use for the destination topic. This should match the schema file name in the schemas directory."^^xsd:string
    ; gate:defaultValue "lidar.osef.scan_frame_dict_value"^^xsd:string .

data:object-counting a gate:Microservice ;
    rdfs:label "Object Counting"@en ;
    intend:name "object-counting"^^xsd:string ;
    intend:description "A microservice counting objects within predefined areas over time intervals. Tracks object counts in zones for specified time frames (e.g., 5 minutes). Reads from object-in-zone-detection Kafka stream and produces object counting events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "traffic-jam"^^xsd:string ;
    gate:keyword "detection"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:chartRepository "oci://registry.gate-ai.eu/intend-charts"^^xsd:anyURI ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "object_counting"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:object-in-zone-detection ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_counting> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_in_zone_detections>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_in_zone_detection> ;
    gate:hasRequiredParameter data:object-counting--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_BOOTSTRAP_SERVER, data:object-counting--KAFKA_DEST_BOOTSTRAP_SERVER, data:object-counting--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:object-counting--ZONES_OF_INTEREST, data:object-counting--OBJECT_TYPE_FILTER, data:object-counting--MAX_SOURCE_EMPTY_POLLS, data:object-counting--SOURCE_AUTO_OFFSET_RESET, data:object-counting--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_TOPIC, data:object-counting--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:object-counting--KAFKA_CONSUMER_GROUP_ID, data:object-counting--KAFKA_DEST_TOPIC, data:object-counting--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

