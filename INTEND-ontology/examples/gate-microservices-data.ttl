data:object-speeds a gate:Microservice ;
    rdfs:label "Object Speeds"@en ;
    intend:name "object-speeds"^^xsd:string ;
    intend:description "A microservice processing OSEF tracked-object data—object IDs, classes & names; kinematics (speed vectors & norms); 3D & SLAM poses; bounding-box sizes, footprints & vertices;  and metadata (properties, age, peak heights, matching pairs, confidence). The service reads a KAFKA stream of OSEF data from LiDAR sensors and produces a KAFKA stream of tracked-object OSEF data."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "osef-streamer"^^xsd:string ;
    gate:keyword "test"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:chartRepository "oci://registry.gate-ai.eu/intend-charts"^^xsd:anyURI ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "object_speeds"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:osef-tracked-objects ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_speeds> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.osef.tracked_objects> ;
    gate:hasRequiredParameter data:object-speeds--KAFKA_SOURCE_BOOTSTRAP_SERVER, data:object-speeds--KAFKA_DEST_BOOTSTRAP_SERVER, data:object-speeds--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:object-speeds--OBJECT_TYPE_FILTER, data:object-speeds--MAX_SOURCE_EMPTY_POLLS, data:object-speeds--SOURCE_AUTO_OFFSET_RESET, data:object-speeds--STRIDE ;
    gate:hasFrozenParameter data:object-speeds--KAFKA_CONSUMER_GROUP_ID, data:object-speeds--KAFKA_SOURCE_TOPIC, data:object-speeds--KAFKA_SOURCE_SCHEMA_VALUE_SUBJECT, data:object-speeds--KAFKA_DEST_TOPIC, data:object-speeds--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

