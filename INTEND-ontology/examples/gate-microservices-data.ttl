    gate:dataType "list"^^xsd:string
    ; gate:description "List of zone IDs or zone names to monitor. Numeric entries are treated as IDs; non-numeric entries as names. If empty, all zones will be monitored."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) for which to generate mock detections. Numeric entries are treated as IDs; non-numeric entries as names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) to keep. Numeric entries are treated as zone IDs; non-numeric entries are treated as zone names. If empty, all zones are processed."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) for which to generate mock alerts. Numeric entries are treated as zone IDs; non-numeric entries as zone names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:description "List of zone names to keep. If empty, all zones are processed."^^xsd:string
    ; gate:description "List of zone names or zone IDs (as strings) for which to generate mock alerts. Numeric entries are treated as IDs; non-numeric entries as names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:defaultValue "[]"^^xsd:string .

