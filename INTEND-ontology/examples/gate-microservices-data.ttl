@prefix intend: <https://w3id.org/intend/ontology#> .
@prefix gate:   <https://w3id.org/intend/extensions/gate#> .
@prefix data:   <https://w3id.org/intend/examples/gate-data#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#
#  GATE microservices data — migrated verbatim from a real GATE
#  Institute knowledge graph (JSON-LD export,
#  https://gate-ai.eu/intend/*, supplied 2026-08-25): 16
#  Kubernetes/Helm microservices forming a Kafka-connected LiDAR/
#  traffic-analytics pipeline (Sofia city deployment). Unrelated to
#  examples/fill-*.ttl and examples/telenor-*.ttl: no shared
#  individuals with either, per the user's own description of the
#  three source KGs as "completamente scollegati".
#
#  KNOWN SOURCE ANOMALIES/OBSERVATIONS (present in the original
#  JSON-LD, kept visible here rather than silently patched):
#   - Two apparent topic-name mismatches: producers write
#     "object_in_zone_detection" (singular) / consumers read
#     "object_in_zone_detections" (plural); producer writes
#     "traffic_jam_detector" / consumer reads
#     "traffic_jam_detections". Modeled as the DISTINCT topics the
#     source actually names (not silently merged/renamed) — this is
#     exactly why data:traffic-jam-alert's intend:dependsOn on
#     data:traffic-jam-detector is NOT reproducible by following the
#     produces/consumes topic graph alone (verified
#     programmatically: the only case where explicit dependsOn and
#     topic-flow-implied dependency disagree). See
#     queries/13-gate-topic-flow-anomalies.rq and
#     queries/14-gate-dependson-vs-topic-flow.rq.
#   - gate:chartRepository is present on exactly 8 of the 16
#     microservices, and empirically these are exactly the 8 that
#     are the intend:dependsOn target of at least one other
#     microservice — preserved as-is, not filled in for the other 8.
#   - Many gate:Parameter individuals carry more than one
#     gate:description value (the same parameter name recurs across
#     microservices and the source appears to merge each
#     recurrence's description into every occurrence) — all
#     description strings are kept, none dropped or picked as "the"
#     canonical one.
#   - gate:chartType/gate:maintainer/gate:imageRepository/
#     gate:imageTag are constant across all 16 microservices in the
#     source data (non-discriminating), migrated verbatim for
#     fidelity.
#   - Kubernetes CPU/memory requests+limits are also identical
#     across all 16 microservices (0.1/1 CPU cores, 512Mi/4Gi
#     memory) in this snapshot of the source.
#
#################################################################

<https://w3id.org/intend/examples/gate-data> a owl:Ontology ;
    rdfs:label "INTEND Ontology - GATE microservices data (from real KG)"@en ;
    owl:imports <https://w3id.org/intend/extensions/gate> .

#################################################################
# Kafka topics
#################################################################

<https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.crosswalk_safety_alert> a gate:KafkaTopic ;
    rdfs:label "Crosswalk Safety Alert"@en ;
    gate:topicName "city_lab.paradise_mall_sofia.lidar.crosswalk_safety_alert"^^xsd:string .

<https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.flow_alert> a gate:KafkaTopic ;
