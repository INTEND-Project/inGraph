data:underspeed-alert a gate:Microservice ;
    rdfs:label "Underspeed Alert"@en ;
    intend:name "underspeed-alert"^^xsd:string ;
    intend:description "A microservice detecting vehicles driving too slowly (underspeed). Monitors vehicle speeds and generates alerts when vehicles fall below minimum speed thresholds. Reads from object-speeds Kafka stream and produces underspeed alert events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "underspeed"^^xsd:string ;
    gate:keyword "alert"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "underspeed_alert"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:object-speeds, data:osef-zones ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.underspeed_alert> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_speeds>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.osef.zones> ;
    gate:hasRequiredParameter data:underspeed-alert--KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER, data:underspeed-alert--KAFKA_SOURCE_OSEF_ZONES_BOOTSTRAP_SERVER, data:underspeed-alert--KAFKA_DEST_BOOTSTRAP_SERVER, data:underspeed-alert--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:underspeed-alert--ZONES_OF_INTEREST, data:underspeed-alert--MIN_SPEED_LIMIT, data:underspeed-alert--MAX_SOURCE_EMPTY_POLLS, data:underspeed-alert--SOURCE_AUTO_OFFSET_RESET, data:underspeed-alert--BUCKET_TIME_WINDOW_MS, data:underspeed-alert--BUCKET_MAX_AGE_SECONDS, data:underspeed-alert--KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC, data:underspeed-alert--KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:underspeed-alert--KAFKA_CONSUMER_GROUP_ID, data:underspeed-alert--KAFKA_SOURCE_OSEF_ZONES_TOPIC, data:underspeed-alert--KAFKA_SOURCE_OSEF_ZONES_SCHEMA_VALUE_SUBJECT, data:underspeed-alert--KAFKA_DEST_TOPIC, data:underspeed-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

