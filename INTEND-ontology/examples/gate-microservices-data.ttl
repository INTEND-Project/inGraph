data:traffic-jam-alert a gate:Microservice ;
    rdfs:label "Traffic Jam Alert"@en ;
    intend:name "traffic-jam-alert"^^xsd:string ;
    intend:description "A microservice generating traffic jam alerts (start and stop) for monitored zones. Monitors traffic jam detector events and generates both start and stop alerts for traffic jams. Each jam is assigned a unique ID and tracked from start to stop. Reads from traffic-jam-detector Kafka stream and produces traffic jam alert events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "traffic-jam"^^xsd:string ;
    gate:keyword "detection"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "traffic_jam_alert"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:traffic-jam-detector ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.traffic_jam_alert> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.traffic_jam_detections> ;
    gate:hasRequiredParameter data:traffic-jam-alert--KAFKA_SOURCE_BOOTSTRAP_SERVER, data:traffic-jam-alert--KAFKA_DEST_BOOTSTRAP_SERVER, data:traffic-jam-alert--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:traffic-jam-alert--PATIENCE, data:traffic-jam-alert--ZONES_OF_INTEREST, data:traffic-jam-alert--ALERT_COOLDOWN_SECONDS, data:traffic-jam-alert--JAM_SEVERITY_THRESHOLD, data:traffic-jam-alert--MAX_SOURCE_EMPTY_POLLS, data:traffic-jam-alert--SOURCE_AUTO_OFFSET_RESET, data:traffic-jam-alert--KAFKA_SOURCE_TOPIC, data:traffic-jam-alert--KAFKA_SOURCE_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:traffic-jam-alert--KAFKA_CONSUMER_GROUP_ID, data:traffic-jam-alert--KAFKA_DEST_TOPIC, data:traffic-jam-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

data:traffic-jam-alert--KAFKA_SOURCE_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_SOURCE_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Source Kafka bootstrap server in the format `host:port`. This is the server from which the service will consume messages."^^xsd:string
    ; gate:description "Source Kafka bootstrap server for traffic jam detection topic in the format `host:port`. This is the server from which the service will consume detection messages."^^xsd:string
    ; gate:description "Source Kafka bootstrap server for zones passing topic in the format `host:port`. This is the server from which the service will consume zone passing messages."^^xsd:string
    ; gate:description "Source Kafka bootstrap server for object-in-zone detection topic in the format `host:port`. This is the server from which the service will consume detection messages."^^xsd:string .

data:traffic-jam-alert--KAFKA_DEST_BOOTSTRAP_SERVER a gate:Parameter ;
    rdfs:label "KAFKA_DEST_BOOTSTRAP_SERVER"@en ;
    gate:parameterName "KAFKA_DEST_BOOTSTRAP_SERVER"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Destination Kafka bootstrap server in the format `host:port`. This is the server to which the service will produce messages."^^xsd:string
    ; gate:description "Kafka bootstrap server in the format `host:port`."^^xsd:string .

data:traffic-jam-alert--KAFKA_SCHEMA_REGISTRY_URL a gate:Parameter ;
    rdfs:label "KAFKA_SCHEMA_REGISTRY_URL"@en ;
    gate:parameterName "KAFKA_SCHEMA_REGISTRY_URL"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "URL of the Schema Registry for Kafka."^^xsd:string .

data:traffic-jam-alert--PATIENCE a gate:Parameter ;
    rdfs:label "PATIENCE"@en ;
    gate:parameterName "PATIENCE"^^xsd:string ;
    gate:dataType "float"^^xsd:string
    ; gate:description "Time in seconds to wait without seeing a traffic jam ID before considering it stopped and generating a STOP alert."^^xsd:string
    ; gate:defaultValue "5.0"^^xsd:string .

data:traffic-jam-alert--ZONES_OF_INTEREST a gate:Parameter ;
    rdfs:label "ZONES_OF_INTEREST"@en ;
    gate:parameterName "ZONES_OF_INTEREST"^^xsd:string ;
    gate:dataType "list"^^xsd:string
    ; gate:description "List of zone IDs or zone names to monitor. Numeric entries are treated as IDs; non-numeric entries as names. If empty, all zones will be monitored."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) for which to generate mock detections. Numeric entries are treated as IDs; non-numeric entries as names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) to keep. Numeric entries are treated as zone IDs; non-numeric entries are treated as zone names. If empty, all zones are processed."^^xsd:string
    ; gate:description "List of zone names or IDs (as strings) for which to generate mock alerts. Numeric entries are treated as zone IDs; non-numeric entries as zone names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:description "List of zone names to keep. If empty, all zones are processed."^^xsd:string
    ; gate:description "List of zone names or zone IDs (as strings) for which to generate mock alerts. Numeric entries are treated as IDs; non-numeric entries as names. If empty, defaults to ['zone_1'] for mock data generation."^^xsd:string
    ; gate:defaultValue "[]"^^xsd:string .

data:traffic-jam-alert--ALERT_COOLDOWN_SECONDS a gate:Parameter ;
    rdfs:label "ALERT_COOLDOWN_SECONDS"@en ;
    gate:parameterName "ALERT_COOLDOWN_SECONDS"^^xsd:string ;
    gate:dataType "int"^^xsd:string
    ; gate:description "Minimum time in seconds between consecutive jam alerts for the same zone. Prevents alert spam during prolonged jams. Default: 60 seconds."^^xsd:string
    ; gate:defaultValue "60"^^xsd:string .

data:traffic-jam-alert--JAM_SEVERITY_THRESHOLD a gate:Parameter ;
    rdfs:label "JAM_SEVERITY_THRESHOLD"@en ;
    gate:parameterName "JAM_SEVERITY_THRESHOLD"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Minimum severity level to generate alerts. Options: 'low', 'medium', 'high'. Low: 5+ vehicles, Medium: 10+ vehicles, High: 20+ vehicles. Default: 'medium'."^^xsd:string
    ; gate:defaultValue "medium"^^xsd:string .

data:traffic-jam-alert--MAX_SOURCE_EMPTY_POLLS a gate:Parameter ;
    rdfs:label "MAX_SOURCE_EMPTY_POLLS"@en ;
    gate:parameterName "MAX_SOURCE_EMPTY_POLLS"^^xsd:string ;
    gate:dataType "Union[int, NoneType]"^^xsd:string
    ; gate:description "Maximum number of empty polls before timing out."^^xsd:string .

data:traffic-jam-alert--SOURCE_AUTO_OFFSET_RESET a gate:Parameter ;
    rdfs:label "SOURCE_AUTO_OFFSET_RESET"@en ;
    gate:parameterName "SOURCE_AUTO_OFFSET_RESET"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Where to start consuming messages if no committed offsets are found. Options are 'earliest' or 'latest'."^^xsd:string
    ; gate:defaultValue "latest"^^xsd:string .

data:traffic-jam-alert--KAFKA_SOURCE_TOPIC a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_TOPIC"@en ;
    gate:parameterName "KAFKA_SOURCE_TOPIC"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the Kafka topic to consume messages from."^^xsd:string
    ; gate:description "Kafka topic for traffic jam detection data."^^xsd:string
    ; gate:description "Kafka topic for zones passing data."^^xsd:string
    ; gate:description "Kafka topic for object-in-zone detection data."^^xsd:string
    ; gate:defaultValue "city_lab.paradise_mall_sofia.lidar.osef.data_streamer"^^xsd:string .

data:traffic-jam-alert--KAFKA_SOURCE_SCHEMA_VALUE_SUBJECT a gate:Parameter ;
    rdfs:label "KAFKA_SOURCE_SCHEMA_VALUE_SUBJECT"@en ;
    gate:parameterName "KAFKA_SOURCE_SCHEMA_VALUE_SUBJECT"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the schema value subject to use for the source topic."^^xsd:string
    ; gate:description "Name of the schema value subject to use for the traffic jam detection topic."^^xsd:string
    ; gate:description "Name of the schema value subject to use for the zones passing topic."^^xsd:string
    ; gate:description "Name of the schema value subject to use for the object-in-zone detection topic."^^xsd:string
    ; gate:defaultValue "lidar.osef.frame_dict_value"^^xsd:string .

data:traffic-jam-alert--KAFKA_CONSUMER_GROUP_ID a gate:Parameter ;
    rdfs:label "KAFKA_CONSUMER_GROUP_ID"@en ;
    gate:parameterName "KAFKA_CONSUMER_GROUP_ID"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Consumer group ID for the Kafka consumer."^^xsd:string
    ; gate:defaultValue "lidar.traffic_jam_alert"^^xsd:string .

data:traffic-jam-alert--KAFKA_DEST_TOPIC a gate:Parameter ;
    rdfs:label "KAFKA_DEST_TOPIC"@en ;
    gate:parameterName "KAFKA_DEST_TOPIC"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the Kafka topic to produce messages to."^^xsd:string
    ; gate:defaultValue "city_lab.paradise_mall_sofia.lidar.traffic_jam_alert"^^xsd:string .

data:traffic-jam-alert--KAFKA_DEST_SCHEMA_VALUE_SUBJECT a gate:Parameter ;
    rdfs:label "KAFKA_DEST_SCHEMA_VALUE_SUBJECT"@en ;
    gate:parameterName "KAFKA_DEST_SCHEMA_VALUE_SUBJECT"^^xsd:string ;
    gate:dataType "str"^^xsd:string
    ; gate:description "Name of the schema value subject to use for the destination topic. This should match the schema file name in the schemas directory."^^xsd:string
    ; gate:defaultValue "lidar.traffic_jam_alert_value"^^xsd:string .

data:traffic-jam-detector a gate:Microservice ;
    rdfs:label "Traffic Jam Detector"@en ;
    intend:name "traffic-jam-detector"^^xsd:string ;
    intend:description "A microservice detecting traffic jams based on vehicle speeds and zone occupancy. Monitors specified zones for low-speed, high-density vehicle patterns. Reads from object-speeds and object-in-zone-detection Kafka streams and produces traffic jam detection events."^^xsd:string ;
    gate:chartVersion "0.1.0"^^xsd:string ;
    gate:appVersion "0.1.0"^^xsd:string ;
    gate:chartType "application"^^xsd:string ;
    gate:keyword "gate"^^xsd:string ;
    gate:keyword "intend"^^xsd:string ;
    gate:keyword "lidar"^^xsd:string ;
    gate:keyword "traffic-jam"^^xsd:string ;
    gate:keyword "detection"^^xsd:string ;
    gate:maintainer "GATE Institute"^^xsd:string ;
    gate:chartRepository "oci://registry.gate-ai.eu/intend-charts"^^xsd:anyURI ;
    gate:imageRepository "registry.gate-ai.eu/intend"^^xsd:string ;
    gate:imageName "traffic_jam_detector"^^xsd:string ;
    gate:imageTag "latest"^^xsd:string ;
    gate:requestsCpuCores "0.1"^^xsd:decimal ;
    gate:limitsCpuCores "1"^^xsd:decimal ;
    gate:requestsMemorySpec "512Mi"^^xsd:string ;
    gate:limitsMemorySpec "4Gi"^^xsd:string ;
    gate:requestsMemoryMiB "512"^^xsd:decimal ;
    gate:limitsMemoryMiB "4096"^^xsd:decimal ;
    intend:dependsOn data:object-in-zone-detection, data:object-speeds ;
    gate:producesToTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.traffic_jam_detector> ;
    gate:consumesFromTopic <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_speeds>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_in_zone_detections>, <https://w3id.org/intend/examples/gate-data#city_lab.paradise_mall_sofia.lidar.object_in_zone_detection> ;
    gate:hasRequiredParameter data:traffic-jam-detector--KAFKA_SOURCE_OBJECT_SPEEDS_BOOTSTRAP_SERVER, data:traffic-jam-detector--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_BOOTSTRAP_SERVER, data:traffic-jam-detector--KAFKA_DEST_BOOTSTRAP_SERVER, data:traffic-jam-detector--KAFKA_SCHEMA_REGISTRY_URL ;
    gate:hasOptionalParameter data:traffic-jam-detector--ZONES_OF_INTEREST, data:traffic-jam-detector--JAM_SPEED_THRESHOLD, data:traffic-jam-detector--MIN_VEHICLE_COUNT, data:traffic-jam-detector--JAM_DURATION_THRESHOLD_SECONDS, data:traffic-jam-detector--ZONE_COVERAGE_THRESHOLD_PERCENT, data:traffic-jam-detector--MAX_SOURCE_EMPTY_POLLS, data:traffic-jam-detector--SOURCE_AUTO_OFFSET_RESET, data:traffic-jam-detector--BUCKET_TIME_WINDOW_MS, data:traffic-jam-detector--BUCKET_MAX_AGE_SECONDS, data:traffic-jam-detector--KAFKA_SOURCE_OBJECT_SPEEDS_TOPIC, data:traffic-jam-detector--KAFKA_SOURCE_OBJECT_SPEEDS_SCHEMA_VALUE_SUBJECT, data:traffic-jam-detector--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_TOPIC, data:traffic-jam-detector--KAFKA_SOURCE_OBJECT_IN_ZONE_DETECTION_SCHEMA_VALUE_SUBJECT ;
    gate:hasFrozenParameter data:traffic-jam-detector--KAFKA_CONSUMER_GROUP_ID, data:traffic-jam-detector--KAFKA_DEST_TOPIC, data:traffic-jam-detector--KAFKA_DEST_SCHEMA_VALUE_SUBJECT .

