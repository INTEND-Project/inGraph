      "@id": "_:nde8f8f5f996343278730c4d88b401c88b8",
      "sh:class": {
        "@id": "fill:Machine"
      },
      "sh:message": "runsOn, when asserted, must point to a Machine. No fixed cardinality: a Container identifies a deployable unit, which can legitimately be deployed to zero (not-yet-scheduled), one, or several Machine individuals — the same container 'kind' can recur across different intents/machines.",
      "sh:minCount": 0,
      "sh:path": {
        "@id": "fill:runsOn"
      }
    },
