  "dcterms:description": {
    "@language": "en",
    "@value": "Standardized, machine-readable framework to express high-level intents\nthat may include multiple goals and requests (data storage, processing, transfer)\nwhile abstracting the underlying infrastructure and technologies. Organized around\nfive dimensions: Intent, User, Resource, Application, Workflow. Built upon TM Forum\nTIO, W3C PROV-O, FOAF and SOSA."
  },
  "dcterms:source": "INTEND HORIZON Research and Innovation Action 101135576",
  "dcterms:title": {
    "@language": "en",
    "@value": "The INTEND Ontology: an ontology for intent-based data operation in the computing continuum"
  },
