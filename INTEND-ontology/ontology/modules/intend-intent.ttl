@prefix intend:  <https://w3id.org/intend/ontology#> .
@prefix tio:     <https://w3id.org/intend/external/tio#> .
@prefix prov:    <http://www.w3.org/ns/prov#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

#################################################################
#
#  INTEND Ontology — Intent module
#  Source: Balzotti et al., "The INTENT Ontology", Section 5.1.1.
#
#  Modeling convention used throughout this project: the paper tags every
#  term with the vocabulary it comes from, e.g. `hasExpectation{tio}` vs
#  `hasIntentReport{intent}`. {tio}/{foaf}/{org}/{sosa}/{prov} tags are
#  implemented as *direct reuse* of the external term; {intent} tags are
#  implemented as native `intend:` terms (occasionally as
#  rdfs:subPropertyOf/subClassOf of an external term when the paper draws
#  an explicit parallel).
#
#################################################################

<https://w3id.org/intend/ontology/intent> a owl:Ontology ;
    rdfs:label "INTEND Ontology - Intent module"@en ;
    owl:imports <https://w3id.org/intend/external/tio> ,
                <http://www.w3.org/ns/prov#> ;
    owl:versionInfo "0.1.0" .

#################################################################
# Classes
#################################################################

intend:Intent a owl:Class ;
    rdfs:subClassOf tio:Intent ;
    rdfs:label "Intent"@en ;
    rdfs:comment """The foundational expression mechanism through which goals and requirements
are articulated in the INTEND ontology. Intent is modeled as a specialization and
contextual extension of tio:Intent (TM Forum TIO), preserving the Expectation/Target/
Condition decomposition while adding explicit links to Resources, Applications and
Workflow components (Section 5.1.1)."""@en .

intend:IntentManager a owl:Class ;
    rdfs:subClassOf tio:IntentManager ;
    rdfs:label "Intent Manager"@en ;
    rdfs:comment """An entity that creates or modifies an Intent. Every intent manager acts either
as owner (it `intend:generates` the Intent) or as handler (the Intent `intend:isSentTo`
it) — see Section 5.1.1. User, Chatbot and Adapter can all act as intent managers;
this class does not force a rigid Owner/Handler subclass split because the very same
agent can be owner for one Intent and handler for another: the role is carried by
which property is asserted, not by the type of the individual."""@en .

intend:IntentReport a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Intent Report"@en ;
    rdfs:comment """Documents how and why the system interpreted, translated, and satisfied (or
not) a user's Intent. Generated by the Explainer via prov:wasGeneratedBy (Section
5.1.1 and 5.1.5). Consists of an ExpectationReport, a ConditionReport and a
TargetReport."""@en .

intend:Capability a owl:Class ;
    rdfs:label "Capability"@en ;
    rdfs:comment """Describes what kind of intents an IntentManager can receive and create,
constraining the scope of its operational role within the intent lifecycle (Section
5.1.1). Also reused by BusinessKnowledge in the Workflow module to describe its
exposed functions (dataUpload, sparqlQuerying, automaticInsightGeneration)."""@en .

#################################################################
# Object properties
#################################################################

intend:hasExpectation a owl:ObjectProperty ;
    rdfs:domain intend:Intent ;
    rdfs:range tio:Expectation ;
    rdfs:label "has expectation"@en ;
    rdfs:comment "The desired outcomes or states that should be achieved by the intent (e.g. \"data must be processed with high accuracy\")." .

intend:hasTarget a owl:ObjectProperty ;
    rdfs:range tio:Target ;
    rdfs:label "has target"@en ;
    rdfs:comment """The subjects of the intent, ranging from specific data objects to computational
processes or infrastructure components. Canonically used as Intent -> Target; no
rdfs:domain is asserted so the same property can also be attached to a specific
Expectation, matching the alternative reading shown in the paper's Figure 3. The
canonical Intent -> Target cardinality is enforced in shapes/intend-shapes-intent.ttl,
not here, precisely to keep this choice a validation-time policy rather than a
hardwired OWL commitment.""" .

intend:hasCondition a owl:ObjectProperty ;
    rdfs:range tio:Condition ;
    rdfs:label "has condition"@en ;
    rdfs:comment """The constraints within which the intent must be fulfilled (temporal limits,
resource boundaries, contextual requirements). Same modeling note as hasTarget above:
no rdfs:domain asserted here on purpose; see shapes/intend-shapes-intent.ttl for the
canonical Intent -> Condition cardinality.""" .

intend:hasIntentReport a owl:ObjectProperty ;
    rdfs:domain intend:Intent ;
    rdfs:range intend:IntentReport ;
    rdfs:label "has intent report"@en .

intend:hasExpectationReport a owl:ObjectProperty ;
    rdfs:domain intend:IntentReport ;
    rdfs:range tio:ExpectationReport ;
    rdfs:label "has expectation report"@en ;
    rdfs:comment "Traces the fulfillment of each expectation." .

intend:hasConditionReport a owl:ObjectProperty ;
    rdfs:domain intend:IntentReport ;
    rdfs:range tio:ConditionReport ;
    rdfs:label "has condition report"@en ;
    rdfs:comment "Traces the satisfaction of each condition." .

intend:hasTargetReport a owl:ObjectProperty ;
    rdfs:domain intend:IntentReport ;
    rdfs:range tio:TargetReport ;
    rdfs:label "has target report"@en ;
    rdfs:comment "Traces the resolution of each target." .

intend:isSentTo a owl:ObjectProperty ;
    rdfs:domain intend:Intent ;
    rdfs:range intend:IntentManager ;
    rdfs:label "is sent to"@en ;
    rdfs:comment "Links the intent to the IntentManager that receives and processes it (handler role)." .

intend:generates a owl:ObjectProperty ;
    rdfs:domain intend:IntentManager ;
    rdfs:range intend:Intent ;
    rdfs:label "generates"@en ;
    rdfs:comment "Links an IntentManager to an Intent it originates (owner role): the owner generates the intent, the handler receives it via isSentTo." .

intend:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:domain intend:Intent ;
    rdfs:range intend:Intent ;
    rdfs:label "was derived from"@en ;
    rdfs:comment "Captures the refinement of a high-level user intent into sub-intents, ensuring traceability across intent hierarchies." .

intend:wasAttributedTo a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasAttributedTo ;
    rdfs:domain intend:Intent ;
    rdfs:range intend:IntentManager ;
    rdfs:label "was attributed to"@en ;
    rdfs:comment "Links each intent instance to the agent (User, Chatbot, or Adapter) responsible for its creation or modification." .

intend:hasCapability a owl:ObjectProperty ;
    rdfs:range intend:Capability ;
    rdfs:label "has capability"@en ;
    rdfs:comment "Describes what kind of intents an IntentManager can receive and create. Domain intentionally left open: also reused by BusinessKnowledge (Workflow module) for its exposed functions." .
